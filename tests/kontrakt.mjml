<mjml>
    <mj-body background-color="#F4F4F4" color="#55575d" font-family="Arial, sans-serif">
        <mj-section background-color="#000000" background-repeat="no-repeat" text-align="center" vertical-align="top">
            <mj-column>

            </mj-column>
        </mj-section>
        <mj-section background-color="#000000" background-repeat="no-repeat" text-align="center" vertical-align="top"
                    padding="0 0 0 0">
            <mj-column>
